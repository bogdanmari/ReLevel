<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\ReLevel.ico</ApplicationIcon>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2025</RevitInstallDir>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\bin\2025+\ReLevel\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Assets\ReLevel16.png;Assets\ReLevel32.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Localization\English.json" />
    <AssemblyMetadata Include="ReLevelProjectDirectory" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <ExternallyResolved>true</ExternallyResolved>
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <ExternallyResolved>true</ExternallyResolved>
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckRevitApi" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RevitInstallDir)\RevitAPI.dll') or !Exists('$(RevitInstallDir)\RevitAPIUI.dll')"
           Text="Revit 2025 API not found. Pass -p:RevitInstallDir=path to the Revit 2025 installation." />
  </Target>
  <Target Name="CopyManifest" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\ReLevel.addin" DestinationFolder="$(OutputPath).." />
    <Message Importance="high" Text="ReLevel: $(TargetPath)" />
  </Target>
</Project>
